{
  "name": "confiance-tech-ecom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "source:product-images": "tsx scripts/source-product-images.ts",
    "crop:logo": "python3 scripts/crop-logo.py",
    "db:backfill-specifications": "tsx scripts/db-backfill-specifications.ts",
    "db:backfill-iphone-unlocked": "tsx scripts/db-backfill-iphone-unlocked.ts",
    "db:backfill-like-new-names": "tsx scripts/db-backfill-like-new-names.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "prepare": "husky",
    "hooks:install": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "next lint --file",
    "*.{ts,tsx}": "tsc-files --noEmit"
  },
  "dependencies": {
    "@holdam/ts": "^2.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/postgres": "^0.10.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "next": "14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.18",
    "dotenv": "^16.4.7",
    "eslint": "^8",
    "eslint-config-next": "14.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsc-files": "^1.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  }
}
