# Copy to .env.local (development) or set in Vercel/hosting dashboard (production).
# Do not commit files that contain real values.

RESEND_API_KEY=re_your_resend_api_key
# Inbox that receives "New Order" notifications (merchant ops, not the customer)
ORDER_NOTIFICATION_EMAIL=you@example.com
# With onboarding@resend.dev (Resend test sender), this MUST be the email on your Resend account.
# For production, verify your domain in Resend and use e.g. orders@yourdomain.com
ORDER_FROM_EMAIL=onboarding@resend.dev
ORDER_FROM_NAME=Confiance Tech

HOLDAM_API_KEY=sk_live_your_holdam_api_key
HOLDAM_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Merchant is inferred from HOLDAM_API_KEY; seller phone is not required at deal create
HOLDAM_BUSINESS_NAME=Confiance Tech
HOLDAM_BASE_URL=https://escrow-backend-production-e42c.up.railway.app/v1
# Calendar days until seller delivery deadline on Holdam checkout (default 5)
HOLDAM_DELIVERY_DAYS=5
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Neon / Vercel Postgres (Neon integration usually sets POSTGRES_URL + POSTGRES_URL_NON_POOLING)
# Optional in local development: when unset, NODE_ENV=development serves the static in-repo catalog.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin panel (/admin) - required in production
ADMIN_PASSWORD=

# Admin AI product copy (OpenAI). Used by "Generate description and specs" in /admin.
ADMIN_OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
# ADMIN_OPENAI_MODEL=gpt-4o-mini
