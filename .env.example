# Copy to .env.local (development) or set in Vercel/hosting dashboard (production).
# Do not commit files that contain real values.

RESEND_API_KEY=re_your_resend_api_key
ORDER_NOTIFICATION_EMAIL=you@example.com
ORDER_FROM_EMAIL=onboarding@resend.dev

HOLDAM_API_KEY=sk_live_your_holdam_api_key
HOLDAM_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
HOLDAM_SELLER_PHONE=08000000000
HOLDAM_BASE_URL=https://escrow-backend-production-e42c.up.railway.app/v1
# Calendar days until seller delivery deadline on Holdam checkout (default 5)
HOLDAM_DELIVERY_DAYS=5
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Neon / Vercel Postgres (Neon integration usually sets POSTGRES_URL + POSTGRES_URL_NON_POOLING)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin panel (/admin) - required in production
ADMIN_PASSWORD=
